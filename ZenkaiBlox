-- ==========================================================
-- QUY TRÌNH TỰ ĐỘNG HOÀN CHỈNH
-- ==========================================================

local function ExecutePrestigeSequence()
    isProcessingSequence = true
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not hrp then 
        isProcessingSequence = false 
        return 
    end

    -- BƯỚC 1: Mở menu map ngầm nhưng ép ẩn giao diện map (Enabled = false) để không hiện lên màn hình
    pcall(function()
        local mapasGui = PlayerGui:FindFirstChild("MapasGui")
        local menuGui = PlayerGui:FindFirstChild("Menu")
        if mapasGui then mapasGui.Enabled = false end
        if menuGui then menuGui.Enabled = false end
        
        if TeleportMapRemote then
            TeleportMapRemote:FireServer("ZenoPalace")
        end
    end)
    StatusLabel.Text = "1. Vào Map ZenoPalace (Ẩn Map)..."
    task.wait(2.5)

    -- BƯỚC 2: Teleport đến thẳng chỗ Zeno
    local currentHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if currentHRP then
        currentHRP.CFrame = ZenoCFrame
    end
    StatusLabel.Text = "2. Đã tới chỗ Zeno!"
    task.wait(0.8)

    -- BƯỚC 3: Tự động tương tác Talk với Zeno
    pcall(function()
        local zenoModel = workspace:FindFirstChild("MissionQuest", true) 
            and workspace.MissionQuest:FindFirstChild("Prestige", true) 
            and workspace.MissionQuest.Prestige:FindFirstChild("Zeno")

        if zenoModel then
            local prompt = zenoModel:FindFirstChildOfClass("ProximityPrompt", true)
            if prompt then
                fireproximityprompt(prompt)
            end
        end
    end)
    StatusLabel.Text = "3. Đang nói chuyện với Zeno..."
    task.wait(0.5)

    -- BƯỚC 4: Tự động bấm Accept Prestige để tăng điểm P
    pcall(function()
        if PrestigeRemote then
            PrestigeRemote:FireServer("Open")
            task.wait(0.3)
            PrestigeRemote:FireServer("Accept")
        end
    end)
    StatusLabel.Text = "4. Đang chờ 16s cập nhật điểm P..."
    
    -- Đợi đúng 16 giây theo yêu cầu để server ổn định điểm Prestige
    task.wait(16)

    -- BƯỚC 5: Kiểm tra điểm Prestige hiện tại và tự động Tele đến map mạnh nhất để treo máy
    pcall(function()
        local pVal = 0
        local prestigeStat = Leaderstats and Leaderstats:FindFirstChild("Prestige")
        if prestigeStat then
            pVal = prestigeStat.Value
        end

        local bestMap = GetBestPrestigeMap(pVal)
        StatusLabel.Text = "5. Vào map mạnh nhất: " .. bestMap

        if TeleportMapRemote then
            TeleportMapRemote:FireServer(bestMap)
        end
    end)

    task.wait(2)
    isProcessingSequence = false
end

