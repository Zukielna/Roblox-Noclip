task.spawn(function()
    while task.wait(Config.TrainDelay) do
        if Config.AutoTrain and not isProcessingSequence then
            pcall(function()
                if TrainingRemote then
                    TrainingRemote:FireServer()
                end
            end)
        end
    end
end)

-- Vòng lặp theo dõi Zenkai
task.spawn(function()
    while task.wait(Config.CheckDelay) do
        if Config.AutoSequence1200 and not isProcessingSequence then
            pcall(function()
                local currentZenkai = 0
                local lstats = LocalPlayer:FindFirstChild("leaderstats")
                local zenkaiStat = lstats and lstats:FindFirstChild("Zenkai")
                
                if zenkaiStat then
                    currentZenkai = zenkaiStat.Value
                else
                    local attrZenkai = LocalPlayer:GetAttribute("Zenkai")
                    if attrZenkai then
                        currentZenkai = attrZenkai
                    end
                end

                if not isProcessingSequence then
                    StatusLabel.Text = "Zenkai: " .. tostring(currentZenkai) .. " / 1200Z"
                end

                if currentZenkai >= 1200 then
                    ExecutePrestigeSequence()
                end
            end)
        end
    end
end)

