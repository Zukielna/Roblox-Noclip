-- ==========================================================
local function ExecutePrestigeSequence()
    isProcessingSequence = true
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then isProcessingSequence = false return end

    pcall(function()
        local mapasGui = PlayerGui:FindFirstChild("MapasGui")
        local menuGui = PlayerGui:FindFirstChild("Menu")
        if mapasGui then mapasGui.Enabled = false end
        if menuGui then menuGui.Enabled = false end
        
        if TeleportMapRemote then TeleportMapRemote:FireServer("ZenoPalace") end
    end)
    StatusDisplay.Text = Config.Language == "VN" and "1. Đang dịch chuyển đến ZenoPalace..." or "1. Entering ZenoPalace..."
    
    task.wait(0.6)

    if char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = ZenoCFrame
    end
