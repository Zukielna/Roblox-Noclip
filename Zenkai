local function ApplyRGBBorder(object)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2.5
    stroke.Parent = object

    task.spawn(function()
        while object and object.Parent do
            for i = 0, 1, 0.003 do
                if not object or not object.Parent then break end
                stroke.Color = Color3.fromHSV(i, 1, 1)
                task.wait(0.02)
            end
        end
    end)
end

-- Hiệu ứng hình mặt trời/tia sáng khi bấm nút
local function AddSunButtonEffect(btn)
    btn.MouseButton1Click:Connect(function()
        local sun = Instance.new("Frame")
        sun.Size = UDim2.new(0, 0, 0, 0)
        sun.Position = UDim2.new(0.5, 0, 0.5, 0)
        sun.AnchorPoint = Vector2.new(0.5, 0.5)
        sun.BackgroundColor3 = Color3.fromRGB(255, 230, 100)
        sun.BackgroundTransparency = 0.3
        sun.BorderSizePixel = 0
        sun.ZIndex = btn.ZIndex + 5
        sun.Parent = btn

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = sun

        TweenService:Create(sun, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 180, 0, 180),
            BackgroundTransparency = 1
        }):Play()

        task.delay(0.4, function()
            if sun then sun:Destroy() end
        end)
    end)
end

